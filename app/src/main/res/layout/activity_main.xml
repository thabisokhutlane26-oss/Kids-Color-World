<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌈 KIDS COLOR WORLD"
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="#673AB7"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ A World Full of Colours! ✨"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#FF7043"
            android:gravity="center"
            android:paddingBottom="18dp"/>

        <!-- WELCOME CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E1F5FE"
            android:padding="20dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎨 LET'S GET CREATIVE!"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#0277BD"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choose your favourite pictures, pick your colours and create something beautiful!"
                android:textSize="16sp"
                android:textColor="#37474F"
                android:gravity="center"
                android:paddingTop="10dp"/>

        </LinearLayout>

        <!-- CATEGORY TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖍️ WHAT WOULD YOU LIKE TO COLOR?"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#5E35B1"
            android:gravity="center"
            android:padding="12dp"/>

        <!-- ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/animalsButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🐶 ANIMALS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF7043"/>

            <Button
                android:id="@+id/toysButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🧸 TOYS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#AB47BC"/>

        </LinearLayout>

        <!-- ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/princessButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="👸 PRINCESS"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EC407A"/>

            <Button
                android:id="@+id/princeButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🤴 PRINCE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#42A5F5"/>

        </LinearLayout>

        <!-- ROW 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/alphabetButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🔤 ALPHABET"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#26A69A"/>

            <Button
                android:id="@+id/numbersButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🔢 NUMBERS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FFA726"/>

        </LinearLayout>

        <!-- ROW 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/natureButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🌳 NATURE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#66BB6A"/>

            <Button
                android:id="@+id/vehiclesButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🚗 VEHICLES"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5C6BC0"/>

        </LinearLayout>

        <!-- ROW 5 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/foodButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🍎 FOOD"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#EF5350"/>

            <Button
                android:id="@+id/everydayButton"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="🏠 EVERYDAY"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8D6E63"/>

        </LinearLayout>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ Learn • Play • Colour • Enjoy! ⭐"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#7B1FA2"
            android:gravity="center"
            android:padding="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Made with ❤️ for little artists"
            android:textSize="14sp"
            android:textColor="#795548"
            android:gravity="center"
            android:paddingBottom="18dp"/>

    </LinearLayout>

</ScrollView>
